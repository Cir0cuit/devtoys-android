<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DevToysAndroid" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F4F5F7</item>
        <item name="android:navigationBarColor">#F4F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4F5F7</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.DevToysAndroid</item>
    </style>
</resources>
